{
  "name": "pokemon-autochess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-asset-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-asset-manifest.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:balance-values": "node scripts/verify-balance-values.mjs",
    "test:psychic-thief": "node scripts/verify-psychic-thief.mjs",
    "test:analytics": "node scripts/verify-analytics-tracker.mjs && node scripts/verify-analytics-validation.mjs",
    "test:author-ui": "node scripts/verify-author-dashboard-ui.mjs",
    "test:permanent-family-buffs": "node scripts/verify-permanent-family-buffs.mjs",
    "test:growth-exp-parity": "node scripts/verify-growth-exp-parity.mjs",
    "test:mobile-safe-area": "node scripts/verify-mobile-safe-area.mjs",
    "test:mobile-unit-sizes": "node scripts/verify-mobile-unit-sizes.mjs",
    "test:eevee-evolution-weights": "node scripts/verify-eevee-evolution-weights.mjs",
    "test:opponent-choice-diversity": "node scripts/verify-opponent-choice-diversity.mjs",
    "test:opponent-choice-ui": "node scripts/verify-opponent-choice-ui.mjs",
    "test:opponent-difficulty-ratings": "node scripts/verify-opponent-difficulty-ratings.mjs",
    "test:opening-stats-opponents": "node scripts/verify-opening-stats-opponents.mjs",
    "test:opponent-preview-ui": "node scripts/verify-opponent-preview-ui.mjs",
    "test:temporary-reward-order": "node scripts/verify-temporary-reward-order.mjs",
    "test:trainer-presentation": "node scripts/verify-trainer-presentation.mjs",
    "test:battle-scenes": "node scripts/verify-battle-scenes.mjs",
    "test:assets": "node scripts/verify-asset-loader.mjs && node scripts/verify-asset-cache.mjs && node scripts/verify-asset-catalog.mjs",
    "test:summon-ownership": "node scripts/verify-summon-ownership.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
